{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "sproutforms-aitest",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": ["-NoProfile", "-File", "scripts/ai-test/run-site.ps1"],
      "port": 5970
    },
    {
      "name": "sproutforms-aitest-backoffice",
      "runtimeExecutable": "pwsh",
      "runtimeArgs": ["-NoProfile", "-File", "scripts/ai-test/run-site.ps1", "-Reset", "-AdminPassword", "SproutForms-AiTest-1"],
      "port": 44370,
      "url": "https://localhost:44370"
    },
    {
      "name": "sproutforms-standalone",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": ["run", "--project", "src/SproutForms.Standalone.Site", "--launch-profile", "SproutForms.Standalone.Site"],
      "port": 5180
    },
    {
      "name": "sproutforms-headless-example",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "src/SproutForms.Client/example", "run", "dev"],
      "port": 5173
    },
    {
      "name": "sproutforms-vue-playground",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:vue"],
      "port": 5174
    },
    {
      "name": "sproutforms-nuxt-playground",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:nuxt"],
      "port": 3000
    }
  ]
}
