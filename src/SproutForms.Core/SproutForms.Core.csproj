<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Product>SproutForms.Core</Product>
    <PackageId>SproutForms.Core</PackageId>
    <Title>SproutForms</Title>
    <Description>Core binaries for the SproutForms package which allows you to easily create forms in code</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0-beta002</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared framework, not the ASP.NET Core 2.x packages: those pull in outdated, vulnerable dependencies. It includes Microsoft.Extensions.Http. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Storage\" />
  </ItemGroup>

</Project>
