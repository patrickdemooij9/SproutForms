<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Product>SproutForms.Core</Product>
    <PackageId>SproutForms.Core</PackageId>
    <Title>SproutForms</Title>
    <Description>Core binaries for the SproutForms package which allows you to easily create forms in code</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>1.0.0--alpha001</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Storage\" />
  </ItemGroup>

</Project>
