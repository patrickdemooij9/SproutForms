@using SproutForms.Core.Models
@using SproutForms.Core.Rendering
@using SproutForms.Umbraco.Core.Models.ViewModels
@model RenderedFormViewModel

@{
    // A form with one page renders exactly as before pages existed: no page wrapper, progress or navigation
    var isPaged = Model.Pages.Count > 1;
    var theme = Html.GetSproutFormsTheme();
}

<div class="form-root" @if (theme != null) { <text>data-sf-theme="@theme"</text> }>
    @if (TempData[$"{Model.Id}:SuccessMessage"] is string message)
    {
        <div class="form-success" data-sf-success role="status">
            @message
        </div>
    }
    else
    {
        <form method="post" action="/api/forms/@Model.Id" novalidate data-form-ajax="true" data-submission-guards='@Json.Serialize(Model.SubmissionGuards)' @if (isPaged) { <text> data-sf-paged="true"</text> } @if (Model.Variables.Count > 0) { <text> data-sf-calculations='@Json.Serialize(new { variables = Model.Variables, calculations = Model.Calculations })'</text> }>
            @Html.AntiForgeryToken()
            <input type="hidden" name="@FormSubmissionRequest.PageUrlKey" value="" data-sf-page-url="true" />
            @foreach (var guard in Model.SubmissionGuards.Where(it => it.PartialViewPath is not null))
            {
                @await Html.PartialAsync(guard.PartialViewPath!)
            }
            @if (isPaged && Model.ShowProgress)
            {
                <ol class="form-progress" data-sf-progress hidden>
                    @foreach (var formPage in Model.Pages)
                    {
                        <li class="form-progress-step" data-sf-progress-step="@formPage.Index">@formPage.ProgressLabel</li>
                    }
                </ol>
            }
            @foreach (var formPage in Model.Pages)
            {
                @if (isPaged)
                {
                    @* Without JavaScript every page shows, one after the other, and the form posts as a whole *@
                    <fieldset class="form-page" tabindex="-1" data-sf-page="@formPage.Index" data-sf-next-label="@formPage.NextLabel" data-sf-previous-label="@formPage.PreviousLabel" @if (formPage.Visibility != null) { <text> data-sf-page-conditions='@Json.Serialize(formPage.Visibility)'</text> }>
                        @if (!string.IsNullOrWhiteSpace(formPage.Title))
                        {
                            <legend class="form-page-title">@formPage.Title</legend>
                        }
                        @await Html.SproutFormsPartialAsync("Rows", formPage.Rows)
                    </fieldset>
                }
                else
                {
                    @await Html.SproutFormsPartialAsync("Rows", formPage.Rows)
                }
            }

            <div class="form-actions">
                @if (isPaged)
                {
                    <button type="button" class="form-previous" data-sf-previous hidden></button>
                    <button type="button" class="form-next" data-sf-next hidden></button>
                }
                <button type="submit">@Model.SubmitLabel</button>
            </div>
        </form>
    }
</div>
