@model string
@{
    Layout = null;
    // ?theme=Example renders the form with a theme from Views/Forms/Themes/
    string theme = Context.Request.Query["theme"].ToString();
}

<!DOCTYPE html>
<html>
    <head>
        <title>AI test: @Model</title>
        <render-form-dependencies></render-form-dependencies>
        <link rel="stylesheet" href="/examples/form-type-examples.css" />
        <script src="/examples/form-type-examples.js"></script>
    </head>
    <body>
        <vc:render-form form-alias="@Model" theme="@theme"></vc:render-form>
    </body>
</html>
