@using SproutForms.Core.Fields.Configs
@using SproutForms.Umbraco.Core.Models.ViewModels
@model FormFieldViewModel
@{
    var config = (DateFieldConfig)Model.Configuration;
    var type = config.IncludeTime ? "datetime-local" : "date";
}

<input type="@type"
       id="@Model.Alias"
       name="@Model.Alias"
       value="@Model.Value"
       class="form-control" />