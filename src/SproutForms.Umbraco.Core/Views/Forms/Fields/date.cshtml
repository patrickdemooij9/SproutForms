@using System.Globalization
@using SproutForms.Core.Fields.Configs
@using SproutForms.Umbraco.Core.Models.ViewModels
@model FormFieldViewModel
@{
    var config = (DateFieldConfig)Model.Configuration;
    var type = config.IncludeTime ? "datetime-local" : "date";
    // Invariant culture: in a custom format ":" is the culture's time separator, and the input needs a literal ":"
    var format = config.IncludeTime ? "yyyy-MM-ddTHH:mm" : "yyyy-MM-dd";
    var minValue = config.Min?.ToString(format, CultureInfo.InvariantCulture);
    var maxValue = config.Max?.ToString(format, CultureInfo.InvariantCulture);
}

<input type="@type"
       id="@Model.Alias"
       name="@Model.Alias"
       value="@Model.Value"
       class="form-control"
       min="@minValue"
       max="@maxValue" />
