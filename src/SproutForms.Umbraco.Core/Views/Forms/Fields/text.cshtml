@using SproutForms.Core.Fields.Configs
@using SproutForms.Umbraco.Core.Models.ViewModels
@model FormFieldViewModel
@{
    var config = (TextFieldConfig)Model.Configuration;
    var dataAttrs = new List<string>();
    
    if (config.MinLength.HasValue)
    {
        dataAttrs.Add($"data-sf-min=\"{config.MinLength.Value}\"");
    }
    if (config.MaxLength.HasValue)
    {
        dataAttrs.Add($"data-sf-max=\"{config.MaxLength.Value}\"");
    }
    if (!string.IsNullOrWhiteSpace(config.Regex))
    {
        dataAttrs.Add($"data-sf-pattern=\"{config.Regex}\"");
    }
}

<input type="text"
       id="@Model.Alias"
       name="@Model.Alias"
       value="@Model.Value"
       placeholder="@config.Placeholder"
       class="form-control"
       @Html.Raw(string.Join(" ", dataAttrs)) />
