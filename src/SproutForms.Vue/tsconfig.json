{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "@sproutforms/client": ["../SproutForms.Client/src/index.ts"],
      "@sproutforms/vue": ["./src/index.ts"]
    }
  },
  "include": ["src", "playground/src"]
}
